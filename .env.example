# GEMINI_API_KEY: Primary Google API - for Voice Live Session and TTS only.
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GOOGLE_API_KEY_1_HERE"

# GEMINI_API_KEY_ORCHESTRATOR: Secondary Google API - for the Orchestrator agent.
# Use a second Google AI Studio account key to separate the load.
GEMINI_API_KEY_ORCHESTRATOR="YOUR_GOOGLE_API_KEY_2_HERE"

# GROQ_API_KEY: For Profile Engine, Explainer, Verifier, and Challenger agents.
# Get your free API key from https://console.groq.com (no credit card required)
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
